{
    "name": "whatsapp-api-baileys",
    "version": "3.0.8",
    "description": "A WhatsApp API built using Baileys library, providing a simple and efficient way to interact with WhatsApp Web.",
    "main": "server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "lint:check": "eslint .",
        "lint:fix": "eslint --fix .",
        "test": "mocha tests/*.test.js --exit",
        "configure-husky": "npx husky install && npx husky add .husky/pre-commit \"npx --no-install lint-staged\""
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{js,jsx}": [
            "prettier --write",
            "git add"
        ],
        "*.{html,css,less,ejs}": [
            "prettier --write",
            "git add"
        ]
    },
    "license": "MIT",
    "dependencies": {
        "@adiwajshing/keyed-db": "^0.2.4",
        "@google-cloud/dialogflow": "^8.4.0",
        "@whiskeysockets/baileys": "^6.7.24",
        "axios": "^1.21.0",
        "body-parser": "^2.4.0",
        "cors": "^2.8.6",
        "dotenv": "^16.0.3",
        "ejs": "^7.0.2",
        "express": "^4.22.3",
        "express-exception-handler": "^1.3.23",
        "google-auth-library": "^11.3.3",
        "link-preview-js": "^5.0.1",
        "mongodb": "^4.12.1",
        "mongoose": "^9.11.4",
        "multer": "^1.4.5-lts.1",
        "pino": "^8.7.0",
        "qrcode": "^1.5.1",
        "sharp": "^0.35.5",
        "socket.io": "^4.8.4",
        "uuid": "^14.0.3"
    },
    "devDependencies": {
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^8.5.0",
        "husky": "^8.0.2",
        "lint-staged": "^15.5.2",
        "mocha": "^11.8.0",
        "nodemon": "^3.1.14",
        "prettier": "^2.8.0",
        "supertest": "^7.3.1"
    }
}
